# Copy this file to .env and fill in real values. Never commit your real .env file.

# Google Gemini API key (required for question/review generation)
GEMINI_API_KEY3=your-gemini-api-key-here

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Optional: database connection string.
# Defaults to a local SQLite file (server/mock_interview.db) if not set.
# For production (e.g. Vercel, which has a read-only filesystem) point this
# at a managed database instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:////absolute/path/to/mock_interview.db
